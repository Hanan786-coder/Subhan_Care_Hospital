# =============================================================
# Subhan Care HMS — Frontend Environment Variables
# =============================================================
# Copy this file to .env and adjust values as needed.
# All VITE_ prefixed vars are exposed to the browser — only
# put public-safe values here. NEVER put API secrets here.
# =============================================================

# API Configuration (URL of the backend API)
VITE_API_BASE_URL=http://localhost:5000/api

# Session timeout in minutes (per FR-10.3)
VITE_SESSION_TIMEOUT=15

# App Name (display only)
VITE_APP_NAME=Subhan Care HMS
