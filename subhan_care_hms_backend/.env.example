# =============================================================
# Subhan Care HMS — Backend Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/subhan_care_hms

# Authentication / Security
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Email / SMTP Configuration (for password reset OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
