# =============================================================
# Subhan Care HMS — Root Environment Variables Reference
# =============================================================
# This project uses separate .env files for backend and frontend.
# See each subdirectory for the actual .env.example files:
#   - subhan_care_hms_backend/.env.example  (server secrets)
#   - subhan_care_hms_frontend/.env.example (public client config)
# =============================================================

# Backend (server-side only — NEVER expose these to the client)
JWT_SECRET=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017/subhan_care_hms
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Frontend (VITE_ prefix = exposed to browser, keep public-safe only)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=Subhan Care HMS
VITE_SESSION_TIMEOUT=15